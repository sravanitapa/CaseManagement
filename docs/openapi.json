  "components": {
    "schemas": {
      "AddCaseNoteRequest": {
        "required": [
          "authorName",
          "content"
        ],
        "type": "object",
        "properties": {
          "authorName": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "AddRoleRequest": {
        "required": [
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "CaseStatus": {
        "enum": [
          "Open",
          "InProgress",
          "DraftComplete",
          "TechReview",
          "AdminReview",
          "Closed"
        ]
      },
      "CloseCaseRequest": {
        "required": [
          "evidenceCount"
        ],
        "type": "object",
        "properties": {
          "evidenceCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateCaseCommand": {
        "required": [
          "title",
          "assignedTo",
          "dueDate",
          "caseStatus",
          "synopsis"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "assignedTo": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "caseStatus": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "synopsis": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RevokeRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "UpdateCaseRequest": {
        "required": [
          "title",
          "assignedTo",
          "dueDate",
          "caseStatus",
          "synopsis"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "assignedTo": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "caseStatus": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "synopsis": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Secured"
    },
    {
      "name": "Cases"
    }
  ]
}